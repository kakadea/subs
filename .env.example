# Public URL behind HestiaCP
BASE_URL=https://subs.example.com
COOKIE_SECURE=true
LOCAL_PROXY_PORT=8081
MAX_UPLOAD_MB=25
SESSION_TTL_HOURS=168
DOWNLOAD_LINK_TTL_HOURS=24

# Use long random values. Never commit the real .env file.
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
