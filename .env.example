# Public URL behind HestiaCP
BASE_URL=https://subs.example.com
COOKIE_SECURE=true
LOCAL_PROXY_PORT=18180
MAX_UPLOAD_MB=25
SESSION_TTL_HOURS=168
DOWNLOAD_LINK_TTL_HOURS=24
METADATA_API_BASE_URL=https://api.tenrai.org/v1

# Use long random values. Never commit the real .env file.
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password
# Apenas para o primeiro bootstrap; depois, remova estas duas linhas do .env real.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Para trocar a senha depois do bootstrap, use scripts/change-admin-password.sh.
# A rotina aceita caracteres especiais sem colocá-los no .env.
